NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payments
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=gpo:

# Idempotency
IDEMPOTENCY_LOCK_TTL_SECONDS=30
IDEMPOTENCY_RECORD_TTL_SECONDS=86400

# Routing weights — used independently in scoring formula
ROUTING_LATENCY_WEIGHT=0.3
ROUTING_SUCCESS_RATE_WEIGHT=0.5
ROUTING_COST_WEIGHT=0.2
ROUTING_MAX_RETRIES=2
ROUTING_RETRY_DELAY_MS=200

# Circuit Breaker
CB_FAILURE_THRESHOLD=5
CB_SUCCESS_THRESHOLD=2
CB_OPEN_TIMEOUT_MS=30000
CB_HALF_OPEN_REQUESTS=3

# Events (Redis Streams)
EVENTS_STREAM_KEY=gpo:events
EVENTS_CONSUMER_GROUP=gpo-consumers
EVENTS_MAX_STREAM_LENGTH=100000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
